{
  "name": "@jackwaddington/amc-client",
  "version": "0.5.0",
  "description": "TypeScript client for AMC's HTTP API — submit jobs, poll or subscribe to live results, check runner status, and read/write Projects, Agents, Batches, and Notes.",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "license": "MIT",
  "author": "Jack Waddington",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackwaddington/amc-client.git"
  },
  "homepage": "https://jackwaddington.github.io/amc-client/",
  "bugs": "https://github.com/jackwaddington/amc-client/issues",
  "keywords": ["amc", "sdk", "client", "ollama", "llm"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "docs:openapi": "tsx scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@eslint/js": "^9",
    "eslint": "^9",
    "openapi3-ts": "^4.6.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
