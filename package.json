{
  "name": "@jackwaddington/amc-client",
  "version": "0.1.0",
  "description": "Server-only TypeScript client for AMC's HTTP API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "docs:openapi": "tsx scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@eslint/js": "^9",
    "eslint": "^9",
    "openapi3-ts": "^4.6.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
